# Resend (transactional email) — powers the contact form and waitlist API routes.
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Verified sender address.
# Production: use an address on a domain you've verified in Resend, e.g. "YIIVA <hello@yiiva.co.za>".
# Quick testing: "onboarding@resend.dev" works but only delivers to your Resend account email.
RESEND_FROM_EMAIL="YIIVA <hello@yiiva.co.za>"

# Where contact-form and waitlist notifications are delivered.
RESEND_TO_EMAIL=hello@yiiva.co.za
